{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "**/*.d.ts",
    "*.{js,jsx}",
    "src/tsconfig.json",
    "src/stories",
    "**/*.css",
    "node_modules/**/*",
    "dist"
  ],
  "singleQuote": true,
  "sortImports": {
    "groups": [
      "builtin",
      ["sibling", "parent"],
      "index"
    ],
    "newlinesBetween": true
  }
}
